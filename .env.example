# ═══════════════════════════════════════════════════════════
# E-CRM Environment Variables — copy to backend/.env and frontend/.env
# The production owner fills in THEIR OWN values below.
# ═══════════════════════════════════════════════════════════

# ── BACKEND (backend/.env) ─────────────────────────────────

# Database (Supabase Postgres). Get from: Supabase Dashboard > Project Settings > Database > Connection string (URI)
# Use the pooled URL (port 6543, ?pgbouncer=true) for DATABASE_URL and the direct URL (port 5432) for DIRECT_URL.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres"

NODE_ENV=production
PORT=5000

# JWT — generate a fresh long random secret. NEVER reuse the sample or a guessable string.
#   Node:    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   OpenSSL: openssl rand -hex 48
# Use DIFFERENT secrets per environment (dev/staging/prod). Rotating this invalidates all issued tokens.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Admin accounts — comma-separated Gmail addresses auto-granted ADMIN on Google login.
# Set the OWNER'S OWN Gmail here.
ADMIN_EMAILS=owner@gmail.com

# Google OAuth — get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (Resend) — get an API key at https://resend.com and verify a sending domain
RESEND_API_KEY=re_your_resend_key
EMAIL_FROM=noreply@yourdomain.com
APP_URL=http://localhost:5173

# Razorpay Payment Gateway — get from https://dashboard.razorpay.com (test keys shown)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Optional: force a specific Chrome/Edge path for WhatsApp (auto-detected on Windows if omitted)
# WHATSAPP_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# CORS — the frontend origin
FRONTEND_URL=http://localhost:5173


# ── FRONTEND (frontend/.env) ───────────────────────────────
VITE_API_URL=http://localhost:5000/api/v1
# Same Google Client ID as the backend
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
