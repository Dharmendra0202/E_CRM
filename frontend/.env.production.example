# ═══════════════════════════════════════════════════════════════════
# FRONTEND PRODUCTION ENV TEMPLATE
# Copy to frontend/.env.production (gitignored) and set for your target.
# Vite inlines VITE_* values into the bundle at build time, so rebuild
# after changing these. These are NOT secrets — they ship to the browser.
# ═══════════════════════════════════════════════════════════════════

# ── Choose ONE VITE_API_URL depending on what you're building ───────
#
# (A) Web deployment — point at your real HTTPS API domain:
VITE_API_URL=https://your-api-domain.com/api/v1
#
# (B) Android APK tested over local WiFi — a phone can't use localhost,
#     so use the dev PC's LAN IP instead (example):
#     VITE_API_URL=http://192.168.0.104:5000/api/v1

# Google OAuth Client ID (public by design — same ID as the backend).
VITE_GOOGLE_CLIENT_ID=<SET>.apps.googleusercontent.com
