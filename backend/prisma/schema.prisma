generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════
// ORGANIZATION & MULTI-TENANT MODELS
// ═══════════════════════════════════════════════════════════════

model Organization {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  name          String
  slug          String         @unique
  type          String         @default("COACHING") // SCHOOL, COACHING, COLLEGE, TRAINING_CENTER
  logo          String?
  email         String?
  phone         String?
  website       String?
  address       String?
  city          String?
  state         String?
  country       String         @default("India")
  pincode       String?
  timezone      String         @default("Asia/Kolkata")
  currency      String         @default("INR")
  language      String         @default("en")
  setupComplete Boolean        @default(false)
  setupStep     Int            @default(1)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  campuses      Campus[]
  departments   Department[]
  academicYears AcademicYear[]
  roles         Role[]
  members       OrgMember[]
}

model Campus {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  name           String
  address        String?
  city           String?
  phone          String?
  isMain         Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Department {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  name           String
  code           String?
  headUserId     String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AcademicYear {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  name           String       // e.g. "2026-27"
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  isCurrent      Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ═══════════════════════════════════════════════════════════════
// ROLE & PERMISSION MODELS (RBAC)
// ═══════════════════════════════════════════════════════════════

model Role {
  id             String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String?
  name           String           // e.g. "Super Admin", "Teacher", "Parent"
  slug           String           // e.g. "super_admin", "teacher"
  description    String?
  isSystem       Boolean          @default(false) // system roles can't be deleted
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  members        OrgMember[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Permission {
  id          String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  module      String           // e.g. "students", "attendance", "fees"
  action      String           // e.g. "create", "read", "update", "delete"
  description String?
  roles       RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  id           String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model OrgMember {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId         String
  organizationId String
  roleId         String
  status         String       @default("ACTIVE") // ACTIVE, INVITED, DISABLED
  joinedAt       DateTime     @default(now()) @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════
// EXISTING MODELS (updated with org relationship)
// ═══════════════════════════════════════════════════════════════

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id                  String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  email               String       @unique
  passwordHash        String
  role                String
  firstName           String
  lastName            String
  phone               String?
  emailVerified       Boolean      @default(false)
  verificationToken   String?      @unique
  verificationExpiry  DateTime?    @db.Timestamptz(6)
  resetToken          String?      @unique
  resetTokenExpiry    DateTime?    @db.Timestamptz(6)
  loginAttempts       Int          @default(0)
  lockedUntil         DateTime?    @db.Timestamptz(6)
  refreshToken        String?      @unique
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  attendanceMarked    Attendance[] @relation("markedBy")
  leadsAssigned       Lead[]       @relation("assignedAdmin")
  orgMemberships      OrgMember[]
  student             Student?
  teacher             Teacher?
}

model Lead {
  id              String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  name            String
  email           String
  phone           String         @default("")
  status          String         @default("NEW") // NEW, CONTACTED, COUNSELLING, FOLLOW_UP, APPLICATION, VERIFICATION, ADMITTED, FEE_PAID, ENROLLED, LOST
  source          String         @default("Manual Entry")
  notes           String?
  assignedAdminId String?
  nextFollowUp    DateTime?      @db.Timestamptz(6)
  expectedJoining DateTime?      @db.Date
  course          String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  assignedAdmin   User?          @relation("assignedAdmin", fields: [assignedAdminId], references: [id], onUpdate: NoAction)
  activities      LeadActivity[]

  @@index([status, createdAt(sort: Desc)])
}

model LeadActivity {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  leadId    String
  type      String   // NOTE, STATUS_CHANGE, FOLLOW_UP, CALL, EMAIL, MEETING, DOCUMENT, PAYMENT
  content   String
  metadata  String?  // JSON string for extra data
  createdBy String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)])
}

model Student {
  id          String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String?           @unique
  parentName  String
  parentPhone String
  parentEmail String
  dateOfBirth DateTime          @db.Date
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  attendance  Attendance[]
  enrollments BatchEnrollment[]
  invoices    Invoice[]
  user        User?             @relation(fields: [userId], references: [id], onUpdate: NoAction)
}

model Teacher {
  id            String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId        String  @unique
  bio           String?
  qualification String
  hourlyRate    Decimal @default(0) @db.Decimal(10, 2)
  batches       Batch[]
  user          User    @relation(fields: [userId], references: [id], onUpdate: NoAction)
}

model Batch {
  id           String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  subject      String
  startDate    DateTime          @db.Date
  endDate      DateTime          @db.Date
  capacity     Int               @default(30)
  teacherId    String
  feeAmount    Decimal           @default(0) @db.Decimal(10, 2)
  feeFrequency String
  teacher      Teacher           @relation(fields: [teacherId], references: [id], onUpdate: NoAction)
  enrollments  BatchEnrollment[]
  schedules    Schedule[]
}

model BatchEnrollment {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId  String
  batchId    String
  enrolledAt DateTime @default(now()) @db.Timestamptz(6)
  status     String   @default("ACTIVE")
  batch      Batch    @relation(fields: [batchId], references: [id], onUpdate: NoAction)
  student    Student  @relation(fields: [studentId], references: [id], onUpdate: NoAction)

  @@unique([studentId, batchId])
}

model Schedule {
  id         String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  batchId    String
  roomOrLink String       @default("")
  dayOfWeek  Int
  startTime  String
  endTime    String
  attendance Attendance[]
  batch      Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([batchId])
  @@index([dayOfWeek, startTime, endTime], map: "Schedule_day_time_idx")
}

model Attendance {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  scheduleId String
  studentId  String
  classDate  DateTime @db.Date
  status     String
  remarks    String?
  markedById String
  recordedAt DateTime @default(now()) @db.Timestamptz(6)
  markedBy   User     @relation("markedBy", fields: [markedById], references: [id], onUpdate: NoAction)
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onUpdate: NoAction)
  student    Student  @relation(fields: [studentId], references: [id], onUpdate: NoAction)

  @@unique([scheduleId, studentId, classDate])
  @@index([scheduleId])
  @@index([studentId])
}

model Invoice {
  id                    String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId             String
  totalAmount           Decimal   @db.Decimal(10, 2)
  status                String    @default("UNPAID")
  dueDate               DateTime  @db.Date
  paidAt                DateTime? @db.Timestamptz(6)
  stripePaymentIntentId String?   @unique
  student               Student   @relation(fields: [studentId], references: [id], onUpdate: NoAction)
  payments              Payment[]

  @@index([status])
  @@index([studentId])
}

model Payment {
  id                   String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  invoiceId            String
  amount               Decimal  @db.Decimal(10, 2)
  paymentMethod        String
  transactionReference String?  @unique
  paidAt               DateTime @default(now()) @db.Timestamptz(6)
  invoice              Invoice  @relation(fields: [invoiceId], references: [id], onUpdate: NoAction)
}

// ═══════════════════════════════════════════════════════════════
// ACADEMIC MANAGEMENT: SUBJECTS & CURRICULUM
// ═══════════════════════════════════════════════════════════════

model Subject {
  id          String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  code        String?
  description String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  homework    Homework[]

  @@unique([name])
}

// ═══════════════════════════════════════════════════════════════
// HOMEWORK & ASSIGNMENTS
// ═══════════════════════════════════════════════════════════════

model Homework {
  id          String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  title       String
  description String?
  subjectId   String?
  batchId     String?
  assignedBy  String               // teacher userId
  dueDate     DateTime             @db.Date
  status      String               @default("ACTIVE") // ACTIVE, CLOSED, CANCELLED
  maxScore    Int?
  attachments String?              // JSON array of file URLs
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  subject     Subject?             @relation(fields: [subjectId], references: [id])
  submissions HomeworkSubmission[]

  @@index([batchId, dueDate(sort: Desc)])
  @@index([assignedBy])
}

model HomeworkSubmission {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  homeworkId  String
  studentId   String
  content     String?  // text submission
  attachments String?  // JSON array of file URLs
  score       Int?
  feedback    String?
  submittedAt DateTime @default(now()) @db.Timestamptz(6)
  gradedAt    DateTime? @db.Timestamptz(6)
  status      String   @default("SUBMITTED") // SUBMITTED, GRADED, LATE, MISSING
  homework    Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([studentId])
}

// ═══════════════════════════════════════════════════════════════
// TRANSPORT MANAGEMENT
// ═══════════════════════════════════════════════════════════════

model TransportRoute {
  id          String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  startPoint  String
  endPoint    String
  distance    String?
  vehicleId   String?
  driverName  String?
  driverPhone String?
  fee         Decimal         @default(0) @db.Decimal(10, 2)
  status      String          @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  stops       TransportStop[]
  vehicle     Vehicle?        @relation(fields: [vehicleId], references: [id])

  @@index([status])
}

model TransportStop {
  id        String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  routeId   String
  name      String
  pickupTime String?
  dropTime  String?
  sortOrder Int            @default(0)
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
}

model Vehicle {
  id              String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  number          String           @unique
  type            String           @default("BUS") // BUS, VAN, CAR, AUTO
  capacity        Int              @default(40)
  driverName      String?
  driverPhone     String?
  insuranceExpiry DateTime?        @db.Date
  status          String           @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  routes          TransportRoute[]
}

// ═══════════════════════════════════════════════════════════════
// LIBRARY MANAGEMENT
// ═══════════════════════════════════════════════════════════════

model Book {
  id            String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  title         String
  author        String
  isbn          String?     @unique
  publisher     String?
  category      String?
  totalCopies   Int         @default(1)
  availableCopies Int       @default(1)
  shelfLocation String?
  status        String      @default("AVAILABLE") // AVAILABLE, LOW_STOCK, OUT_OF_STOCK
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  issues        BookIssue[]
}

model BookIssue {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  bookId     String
  issuedTo   String    // userId or studentId
  issuedBy   String?   // librarian userId
  issueDate  DateTime  @default(now()) @db.Timestamptz(6)
  dueDate    DateTime  @db.Date
  returnDate DateTime? @db.Timestamptz(6)
  fine       Decimal   @default(0) @db.Decimal(10, 2)
  status     String    @default("ISSUED") // ISSUED, RETURNED, OVERDUE, LOST
  book       Book      @relation(fields: [bookId], references: [id])

  @@index([bookId])
  @@index([issuedTo])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════
// COMMUNICATION CENTER
// ═══════════════════════════════════════════════════════════════

model Announcement {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  title       String
  content     String
  type        String   @default("GENERAL") // GENERAL, ACADEMIC, EVENT, HOLIDAY, EMERGENCY, FEE_REMINDER
  audience    String   @default("ALL") // ALL, STUDENTS, PARENTS, TEACHERS, STAFF, BATCH_SPECIFIC
  batchId     String?  // if audience is BATCH_SPECIFIC
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  publishedBy String
  publishedAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime? @db.Timestamptz(6)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([type, isActive])
  @@index([audience])
}
