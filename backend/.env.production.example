# ═══════════════════════════════════════════════════════════════════
# BACKEND PRODUCTION ENV TEMPLATE
# Copy to your host's secret manager / .env (NEVER commit real values).
# Every value marked <SET ...> must be replaced before going live.
# ═══════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=5000

# ── Database (Supabase Postgres) ────────────────────────────────────
# Pooled URL (port 6543) for DATABASE_URL, direct URL (port 5432) for DIRECT_URL.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"

# ── Supabase API ────────────────────────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<SET supabase anon key>
SUPABASE_SERVICE_ROLE_KEY=<SET supabase service role key — keep secret, server-only>

# ── JWT ─────────────────────────────────────────────────────────────
# MUST be unique + random + >=32 chars, or the server refuses to start in prod.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<SET strong random secret>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── URLs / CORS (use your REAL domain — not localhost or a LAN IP) ───
FRONTEND_URL=https://your-domain.com
APP_URL=https://your-domain.com
# Comma-separated whitelist. Include Capacitor origins for the Android app.
ALLOWED_ORIGINS=https://your-domain.com,capacitor://localhost,https://localhost

# ── Google OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<SET>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<SET google client secret>
# Comma-separated Gmail addresses auto-granted ADMIN on Google login.
ADMIN_EMAILS=owner@your-domain.com

# ── Email (Resend) ──────────────────────────────────────────────────
# Sandbox sender (onboarding@resend.dev) only delivers to the account owner.
# Verify your own domain in Resend and use a real from-address for production.
RESEND_API_KEY=<SET resend api key>
EMAIL_FROM=noreply@your-domain.com

# ── Payments (Razorpay) ─────────────────────────────────────────────
# Test keys (rzp_test_...) do NOT process real payments. Use LIVE keys.
RAZORPAY_KEY_ID=<SET rzp_live_... key id>
RAZORPAY_KEY_SECRET=<SET razorpay live secret>

# ── SMS / WhatsApp (Twilio) — optional, leave blank to disable ──────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
